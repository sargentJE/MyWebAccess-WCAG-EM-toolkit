{
  "name": "legacy-events",
  "rootUrl": "https://example.com/",
  "scope": {
    "mode": "same-hostname",
    "allowedHosts": []
  },
  "crawl": {
    "maxPages": 80,
    "maxConcurrency": 5,
    "requestTimeoutSecs": 90,
    "requestDelayMs": 500,
    "excludeUrlPatterns": ["/wp-admin", "\\?replytocom=", "/feed/?$"],
    "sitemapSeeding": {
      "enabled": true,
      "urls": [],
      "commonPaths": ["/sitemap.xml", "/sitemap_index.xml"],
      "maxUrls": 500
    }
  },
  "discovery": {
    "captureH1": true,
    "captureCanonical": true,
    "captureForms": true,
    "captureLandmarks": true,
    "captureSearchInputs": true
  },
  "sample": {
    "structuredManual": [
      "https://example.com/",
      "https://example.com/about/",
      "https://example.com/contact-us/",
      "https://example.com/privacy-policy/",
      "https://example.com/services/",
      "https://example.com/services/service-a/",
      "https://example.com/services/service-b/",
      "https://example.com/work/",
      "https://example.com/work/case-study/",
      "https://example.com/blog/",
      "https://example.com/blog/post/"
    ],
    "autoSuggest": {
      "enabled": true,
      "perCluster": 1,
      "preferTypes": ["homepage", "form-or-contact", "policy", "listing", "detail", "content"]
    },
    "randomPercentOfStructured": 0.1,
    "minRandomPages": 2,
    "randomSeed": 1,
    "smallSiteSupplementaryScanThreshold": 50
  },
  "scan": {
    "viewports": [
      {
        "id": "desktop",
        "width": 1280,
        "height": 800
      },
      {
        "id": "reflow",
        "width": 320,
        "height": 800
      }
    ],
    "waitUntil": "domcontentloaded",
    "timeoutMs": 60000,
    "retries": 1,
    "fullPageScreenshots": true,
    "axe": {
      "include": [],
      "exclude": [],
      "withRules": [],
      "withTags": ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22aa", "best-practice"],
      "runOnly": null
    }
  },
  "processes": [],
  "reporting": {
    "reporters": ["json", "markdown", "html", "earl-jsonld", "junit"],
    "groupBestPracticeSeparately": true,
    "failOnFindings": {
      "impacts": ["critical", "serious"],
      "classifications": [],
      "threshold": 1
    }
  },
  "wcagEm": {
    "wcagVersion": "2.2",
    "conformanceTarget": "AA",
    "atBaseline": [],
    "technologiesReliedUpon": ["HTML", "CSS", "JavaScript", "WAI-ARIA"],
    "samplingMethodNotes": "Structured sample (WCAG-EM Step 3a) curated by the auditor: homepage, about, contact, privacy policy, a services listing with two service pages, a work listing with one case study, and a blog listing with one post, covering each distinct page type. Supplemented by toolkit auto-suggest and a 10% random pool.",
    "evaluator": {
      "name": "Example Evaluator",
      "contact": "evaluator@example.com"
    }
  }
}
